<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" shutdownHook="disable">

    <Properties>
        <!-- Паттерн для консоли (короткий) -->
        <Property name="CONSOLE_PATTERN">%d{HH:mm:ss} [%t] %-5level %logger{20} - %msg%n</Property>

        <!-- Паттерн для файла (полный) -->
        <Property name="FILE_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n</Property>

        <!-- Путь к логам -->
        <Property name="LOG_DIR">logs</Property>

        <!-- Имя лог-файла -->
        <Property name="LOG_FILE_NAME">hotel-client</Property>
    </Properties>

    <!-- ======================== АППЕНДЕРЫ ======================== -->
    <Appenders>

        <!-- 1. КОНСОЛЬ -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${CONSOLE_PATTERN}"/>
        </Console>

    </Appenders>

    <Loggers>
        <Logger name="com.hotel.client" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>

        <!-- КОРНЕВОЙ ЛОГГЕР -->
        <Root level="ERROR">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
        </Root>

    </Loggers>

</Configuration>